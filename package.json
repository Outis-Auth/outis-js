{
  "name": "@outis-auth/sdk",
  "version": "0.1.0",
  "description": "The Outis client: ask for a human authorization, observe the decision, run sealed intents from your own worker.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Outis-Auth/outis-js.git"
  },
  "homepage": "https://developers.outis.tech/guides/sdks/",
  "bugs": "https://github.com/Outis-Auth/outis-js/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "outis": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "tsc -p tsconfig.test.json && tsc -p tsconfig.examples.json && node --test .test-build/test/*.test.js",
    "vectors": "tsc -p tsconfig.test.json && OUTIS_WRITE_RECIPE_VECTORS=1 node --test .test-build/test/recipes.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.0"
  }
}
